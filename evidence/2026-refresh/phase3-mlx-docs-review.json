  "truth_review": [
    {
      "criterion": "Selected support and qualification scope",
      "result": "pass",
      "docs": "docs/docs/mlx.md:3 and installation/quickstart/development cross-links",
      "evidence": "LeNet-5/MNIST sample-weighted FedAvg, float32 Apple CPU/Metal and Python 3.13 are bounded explicitly. .python-version selects 3.13 and Linux PyTorch CI selects 3.13 core profiles. No native Linux/CUDA/Windows, hosted Mac CI, Python 3.14, MLX-LM/LoRA, broad architecture/algorithm parity or mixed-framework conversion claim was found. Packaging >=3.13 is not misrepresented as a qualification matrix."
    },
    {
      "criterion": "Device selection and stream placement",
      "result": "pass",
      "docs": "docs/docs/mlx.md:18 and docs/docs/mlx.md:109",
      "evidence": "_resolve_device gives CPU precedence to --cpu, explicit --mps requires Metal, and otherwise returns mx.default_device. Trainer factory/train/test and validated restoration use the selected stream. The guide states normally Metal and discloses prebuilt lazy work retaining original placement."
    },
    {
      "criterion": "Exact seed scope and legacy omission",
      "result": "pass",
      "docs": "docs/docs/mlx.md:57 and docs/docs/configurations/trainer.md:219",
      "evidence": "model_seed wraps construction without reinitializing caller instances. training_seed derives SHA256-based logical master/client/round/epoch identities, including epoch zero run setup, independent of worker PID/order. Seeded scopes save/restore Python, NumPy, PyTorch CPU and MLX state; no seed yields without restoration, preserving legacy unseeded behavior. Same-environment replay and tolerance-only cross-device comparison are stated. Data partition/server seeds are separately required."
    },
    {
      "criterion": "Clipping, optimizer, loss and scheduler contract",
      "result": "pass",
      "docs": "docs/docs/mlx.md:67 through docs/docs/mlx.md:105",
      "evidence": "Config-driven clipping is optional, finite/nonnegative, zero-valid and applied globally before one update; nonfinite gradients/norms reject before optimizer update. Custom steps retain responsibility. Names lower-case into Adam/AdamW/SGD/momentum/RMSprop/Lion; momentum requires an explicit value. Each option in the table exactly matches installed MLX 0.32.3 constructor source. Arguments pass directly. jit=True is rejected; eager materialization, cross entropy, accuracy and no default scheduler update match source. No PyTorch accumulation/mixed precision/scheduler parity is promised."
    },
    {
      "criterion": "Tree ownership, validation and weighted aggregation",
      "result": "pass",
      "docs": "docs/docs/mlx.md:121",
      "evidence": "Owned host snapshots, exact dict/list/tuple keys/kinds/lengths/shapes and None compatibility match native validation/extraction. Server ingress validates report/payload cardinality and finite nonnegative sample weights, with finite total also enforced by source. Sample-weighted floating results align to reference dtypes and existing zero-total direct/delta fallback leaves weights unchanged."
    },
    {
      "criterion": "Hook positional association and side effects",
