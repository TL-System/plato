    "path": "/tmp/plato-retirement-validate-integrity.py",
    "sha256": "e571e1ab60c970d355a0d6a33bf1566aacf30025d6db9e16a80e011965215cac",
    "source": "from pathlib import Path\nimport hashlib\nimport json\nimport subprocess\nimport tarfile\nimport zipfile\n\nroot = Path.cwd()\nresults = {}\nfor backend in ('nanochat', 'lerobot'):\n    manifest = json.loads((root / 'archives/retired' / backend / 'manifest.json').read_text())\n    for entry in manifest['files']:\n        original = subprocess.check_output(['git', 'show', f\"{manifest['pre_retirement_plato_commit']}:{entry['original_path']}\"])\n        archived = (root / entry['archive_path']).read_bytes()\n        assert original == archived\n        assert hashlib.sha256(original).hexdigest() == entry['sha256']\n    results[backend] = {'original_files': len(manifest['files']), 'all_match_original_git_blobs': True}\n    if backend == 'nanochat':\n        upstream = manifest['upstream']\n        with tarfile.open(root / upstream['archive_path']) as source:\n            for entry in upstream['files']:\n                file = source.extractfile(entry['path'])\n                assert file is not None\n                data = file.read()\n                git_blob = hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\\0' + data).hexdigest()\n                assert git_blob == entry['git_blob']\n                # Git records executable bits, not Unix group-write permissions.\n                assert source.getmember(entry['path']).mode & 0o111 == int(entry['git_mode'][-3:], 8) & 0o111\n        results[backend]['upstream_tracked_files'] = len(upstream['files'])\n        results[backend]['upstream_git_blobs_and_executable_modes_match'] = True\nfor path in Path('/tmp/plato-retirement-dist').glob('*'):\n    if path.suffix == '.whl':\n        with zipfile.ZipFile(path) as package:\n            names = package.namelist()\n    elif path.name.endswith('.tar.gz'):\n        with tarfile.open(path) as package:\n            names = package.getnames()\n    else:\n        continue\n    assert not any('/archives/retired/' in '/' + name or '/external/nanochat/' in '/' + name for name in names)\n    assert not any('/plato/' in '/' + name and any(term in name.lower() for term in ('nanochat', 'lerobot', 'smolvla')) for name in names)\n    results[path.name] = {'entries': len(names), 'archive_or_retired_runtime_entries': 0, 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}\nPath('/tmp/plato-retirement-integrity-and-build.json').write_text(json.dumps(results, indent=2) + '\\n')\nprint(json.dumps(results, indent=2))\n"
  },
